#!/usr/bin/env python3
"""Turn Claude Code's OpenTelemetry export to the local otel-lgtm stack on or off.

ops/telemetry on|off|status

Writes the `env` block of ~/.claude/settings.json (or $CLAUDE_CONFIG_DIR/settings.json),
keeping every other setting. A repo's .claude/settings.json can't set these: Claude Code
ignores OTEL exporter variables there. New sessions pick the change up.
"""
import json
import os
import sys
from pathlib import Path

ENV = {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "http/protobuf",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4318",
    # Delta: Prometheus stores it as-is (otlp-native-delta-ingestion); dashboards use sum_over_time.
    "OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE": "delta",
    "OTEL_METRIC_EXPORT_INTERVAL": "30000",
}


def settings_path():
    base = os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude"
    return Path(base) / "settings.json"


def main(argv):
    if len(argv) != 1 or argv[0] not in ("on", "off", "status"):
        print(__doc__.strip().splitlines()[2], file=sys.stderr)
        return 2
    path = settings_path()
    settings = json.loads(path.read_text()) if path.exists() else {}
    env = settings.get("env", {})
    if argv[0] == "status":
        on = all(env.get(k) == v for k, v in ENV.items())
        print(f"telemetry {'on' if on else 'off'} ({path})")
        return 0
    if argv[0] == "on":
        env.update(ENV)
    else:
        for k, v in ENV.items():
            if env.get(k) == v:
                del env[k]
    if env:
        settings["env"] = env
    else:
        settings.pop("env", None)
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(settings, indent=2) + "\n")
    tmp.replace(path)
    print(f"telemetry {argv[0]} ({path}); applies to new Claude Code sessions")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
